{
  "name": "local-preview",
  "displayName": "Local Preview",
  "description": "Preview your site locally, right within VS Code.",
  "version": "0.8.4",
  "publisher": "LWilhelmer",
  "author": "Lars Wilhelmer",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/wilhelmer/local-preview#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wilhelmer/local-preview.git"
  },
  "bugs": {
    "url": "https://github.com/wilhelmer/local-preview/issues"
  },
  "keywords": [
    "localhost",
    "static",
    "site",
    "generator",
    "live",
    "preview"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": ["localPreview.mappings", "localPreview.server.command", "localPreview.server.port"]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "localPreview.openWindow",
        "title": "Local Preview: Open in Window",
        "icon": {
          "light": "media/window-globe-light.svg",
          "dark": "media/window-globe-dark.svg"
        }
      },
      {
        "command": "localPreview.openSplit",
        "title": "Local Preview: Open in Split Pane",
        "icon": {
          "light": "media/split-globe-light.svg",
          "dark": "media/split-globe-dark.svg"
        }
      },
      {
        "command": "localPreview.addMapping",
        "title": "Local Preview: Add Mapping",
        "icon": "$(add)"
      },
      {
        "command": "localPreview.stopServer",
        "title": "Local Preview: Stop Server"
      }
    ],
    "keybindings": [
      {
        "command": "localPreview.openSplit",
        "key": "ctrl+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "localPreview.openWindow",
        "key": "ctrl+alt+o",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "localPreview.openSplit",
          "group": "navigation",
          "when": "resourceSet"
        },
        {
          "command": "localPreview.openWindow",
          "group": "navigation",
          "when": "resourceSet"
        }
      ]
    },
    "configuration": {
      "title": "Local Preview",
      "properties": {
        "localPreview.server.command": {
          "order": 0,
          "type": "string",
          "default": "",
          "description": "Command that starts your server, e.g., \"yarn run start\". Runs when a new preview opens and the server port is not in use. Ignored in untrusted workspaces."
        },
        "localPreview.server.port": {
          "order": 1,
          "type": "number",
          "default": 0,
          "description": "Port the server listens on. If nothing listens there when a preview opens, the server command is run. 0 disables."
        },
        "localPreview.mappings": {
          "order": 2,
          "type": "array",
          "default": [],
          "description": "Mappings of { pattern, url }. Pattern is a regex tested against the workspace-relative path, then the absolute path, first match wins. Url may use capture groups like $1."
        },
        "localPreview.followMode": {
          "order": 3,
          "type": "string",
          "default": "content",
          "enum": ["off", "files", "headings", "content"],
          "enumItemLabels": ["Off", "Follow files", "Follow files and Markdown headings", "Follow files, Markdown headings, and content"],
          "description": "What the preview follows: nothing (off), the active file, plus Markdown headings (when the cursor is on one), or plus any Markdown content."
        },
        "localPreview.server.runInBackground": {
          "order": 5,
          "type": "boolean",
          "default": false,
          "description": "Runs the server in the background and stops it when the preview closes. When disabled, runs in the terminal, without auto-stop."
        },
        "localPreview.previewWidth": {
          "order": 6,
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 99,
          "description": "Width of the split preview in percent of the editor area when it opens. Applied only when two editor groups exist. 0 keeps VS Code's default split width."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  }
}
